# Main background
 theme[main_bg]="#2E3440"
 theme[main_fg]="#D8DEE9"

# Title color
 theme[title]="#E5E9F0"

# Highlighted text and active UI elements
 theme[hi_fg]="#88C0D0"
 theme[selected_bg]="#3B4252"
 theme[selected_fg]="#ECEFF4"

# Normal text / separators
 theme[inactive_fg]="#8FBCBB"
 theme[fg]="#D8DEE9"

# Graph colors
 theme[proc_misc]="#81A1C1"
 theme[cpu_box]="#A3BE8C"
 theme[mem_box]="#88C0D0"
 theme[net_box]="#B48EAD"
 theme[proc_box]="#EBCB8B"

# Status colors
 theme[div_line]="#4C566A"
 theme[temp_start]="#EBCB8B"
 theme[temp_mid]="#D08770"
 theme[temp_end]="#BF616A"
 theme[cpu_start]="#A3BE8C"
 theme[cpu_mid]="#EBCB8B"
 theme[cpu_end]="#D08770"
 theme[free]="#8FBCBB"
 theme[used]="#81A1C1"
 theme[cache]="#B48EAD"
 theme[available]="#A3BE8C"
 theme[download]="#88C0D0"
 theme[upload]="#B48EAD"

# Text and progress indicators
 theme[header]="#ECEFF4"
 theme[graph_text]="#D8DEE9"
 theme[meter]="#88C0D0"
 theme[clock]="#88C0D0"
